import tkinter as tk
import os
from tkinter import ttk
from tkinter import messagebox
from functools import partial
from jsonhandler import jsonloader


LARGEFONT = ("Verdana", 35)
MENU_ROW_LOC=2 #Change name to clearer represent what location is represented


class tkinterApp(tk.Tk):
    # __init__ function for class tkinterApp
    def __init__(self, *args, **kwargs):
        # __init__ function for class Tk
        tk.Tk.__init__(self, *args, **kwargs)
        self.minsize(550, 350)

        # creating a container
        container = tk.Frame(self)
        container.pack(side="top", fill="both", expand=True)
        # container.grid_columnconfigure((0, 1, 2, 3, 4), weight=1)
        # container.grid_rowconfigure((0, 1, 2, 3, 4), weight=1)
        # container.grid_columnconfigure(0, weight=1)

        # initializing frames to an empty array
        self.frames = {}
        MENU_ROW_LOC = {}
        # iterating through a tuple consisting
        # of the different page layouts
        for F in (ScanPage, ConfigPage, DeployPage,UpdatePage):
            frame = F(container, self)

            # initializing frame of that object from
            # startpage, page1, page2 respectively with
            # for loop
            self.frames[F] = frame
            frame.grid(row=2, column=0, sticky="nsew")

        self.show_frame(ScanPage)

    # to display the current frame passed as
    # parameter
    def show_frame(self, cont):
        frame = self.frames[cont]
        frame.tkraise()


# first window frame startpage
def select_system(self,input_function):
    directory = os.path.dirname(__file__)
    files = os.listdir(directory)
    # print(files)
    
    directory = os.path.dirname(__file__)
    file = "jsonfile.json"
    filepath = os.path.join(directory, file)
    
    jsondata = jsonloader(filepath)
    # print(f"jsondata: {jsondata}")
    # print(f"jsondata users: {jsondata['users']}") #List of al json file contents under "users"
    # print(f"jsondata users name: {jsondata['users'][0]['name']}") #This is just the name for the first entry in the json file

    def retrieve_input():
        print(opt.get())
        print(opt2.get())

    def update_ms_list(ms):
        # ms = opt.get()
        # print(ms)
        # ms_list = {
        #     "Monday": ["1", "2"],
        #     "Tuesday": ["12", "22"],
        #     "Wednesday": ["13", "23"],
        #     "Thursday": ["14", "24"],
        #     "Friday": ["15", "25"],
        #     "Saturday": ["16", "26"],
        #     "Sunday": ["17", "27"]
        # }
        # ms = ms_list[ms]
        # action_with_arg = partial(input_function, opt2.get())
        # tk.OptionMenu(self, opt2, *ms,command=action_with_arg).grid(row=3, column=2, padx=10, pady=10)
        ms_list = {}
        # ms = opt.get()
        ms = []
        print(f"first ms: {ms}")
        for count, users in enumerate(jsondata['users']):
            entry = {users['name']: count}
            ms_list.update(entry)
            # print(f"this is the users in jsondata: {users}")
        print(f"ms_list: {ms_list}")
        for key in ms_list:
            ms.append(key)
        print(f"second ms: {ms}")
        # ms = ms_list[ms]
        opt2 = tk.StringVar(value=ms[0])
        action_with_arg = partial(input_function, opt2.get())
        tk.OptionMenu(self, opt2, *ms,command=action_with_arg).grid(row=3, column=2, padx=10, pady=10)

    # Dropdown options 

    # env = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
    env = files
    # Selected option variable
    # opt = tk.StringVar(value="Monday")
    opt = tk.StringVar(value=env[0])

    tk.OptionMenu(self, opt, *env, command=update_ms_list).grid(row=3, column=1, padx=10, pady=10)

    # Dropdown options
    ms = ["1", "2", "3", "4", "5", "6", "7"]
    # Selected option variable
    opt2 = tk.StringVar(value="1")
    # opt2 = tk.StringVar(value=ms[0])


def menu_bar(self,controller):
    menu_border = tk.Frame(self, bd=2, relief="solid")
    menu_border.grid(row=2, column=0, padx=10, pady=5, columnspan=4, sticky="nsew",)
    
    scan_button = ttk.Button(menu_border, text="Scan",
                         command=lambda: controller.show_frame(ScanPage))
    # putting the button in its place by using grid
    scan_button.grid(row=2, column=0, padx=10, pady=10)
    
    config_button = ttk.Button(menu_border, text="Display Config",
                         command=lambda: controller.show_frame(ConfigPage))
    # putting the button in its place by using grid
    config_button.grid(row=2, column=1, padx=10, pady=10)

    # button to show frame 2 with text layout2
    deploy_button = ttk.Button(menu_border, text="Deploy",
                         command=lambda: controller.show_frame(DeployPage))
    # putting the button in its place by using grid
    deploy_button.grid(row=2, column=2, padx=10, pady=10)
    
    # button to show frame 2 with text layout2
    update_button = ttk.Button(menu_border, text="Update Config",
                         command=lambda: controller.show_frame(UpdatePage))
    # putting the button in its place by using grid
    update_button.grid(row=2, column=3, padx=10, pady=10)


class ScanPage(tk.Frame):
    def __init__(self, parent, controller):
        tk.Frame.__init__(self, parent)
        
        self.grid_columnconfigure((0, 1, 2, 3), weight=1)
        # self.grid_rowconfigure((0, 1, 2, 3, 4), weight=1)
        
        def label_updater(label, text):
            label.config(text=text)

        #Title Label
        label = ttk.Label(self, text="Scan", font=LARGEFONT)
        # putting the grid in its place by using grid
        label.grid(row=0, column=0, padx=10, pady=10, columnspan=4)

        menu_bar(self, controller)
        #constant_buttons(self)
        scan_label = ttk.Label(self, text="Choose a system to scan")
        scan_label.grid(row=4, column=0, padx=10, pady=5, columnspan=4)
        # Dropdown options
        env_scan=["sit","dev","nft","uat"]
        for count,env in enumerate(env_scan):
            # add exe call here
            # action_with_arg = partial(print, env)
            # button to show frame 2 with text layout2
            button3 = ttk.Button(self, text=env, command=lambda env=env: label_updater(scan_label, env))
            # putting the button in its place by using grid
            button3.grid(row=3, column=count)

            

# second window frame page1
class ConfigPage(tk.Frame):
    def __init__(self, parent, controller):
        tk.Frame.__init__(self, parent)
        label = ttk.Label(self, text="display_config", font=LARGEFONT)
        label.grid(row=0, column=0, padx=10, pady=10, columnspan=4)
        menu_bar(self, controller)
        select_system(self,print)


# third window frame page2
class DeployPage(tk.Frame):
    def __init__(self, parent, controller):
        tk.Frame.__init__(self, parent)
        label = ttk.Label(self, text="deploy", font=LARGEFONT)
        label.grid(row=0, column=0, padx=10, pady=10, columnspan=4)
        menu_bar(self, controller)
        select_system(self, print)

        def get_text():
            inputValue = textBox.get("1.0", "end-1c")

        textBox = tk.Text(self, height=10, width=50)
        textBox.grid(row=4, column=0, padx=10, pady=10, columnspan=4)

        buttonCommit = tk.Button(self, height=1, width=10, text="Commit",
                                 command=lambda: get_text())
        # command=lambda: retrieve_input() >>> just means do this when i press the button
        buttonCommit.grid(row=3, column=3, padx=10, pady=10)



class UpdatePage(tk.Frame):
    def __init__(self, parent, controller):
        tk.Frame.__init__(self, parent)
        label = ttk.Label(self, text="update_config", font=LARGEFONT)
        label.grid(row=0, column=0, padx=10, pady=10, columnspan=4)
        menu_bar(self, controller)
        select_system(self,print)
        def get_text():
            inputValue = textBox.get("1.0", "end-1c")
            
        def read_file():
            textBox.delete("1.0", "end") #this clears the text box
            directory = os.path.dirname(__file__)
            file = "jsonfile.json"
            filepath = os.path.join(directory, file)
            
            jsondata = jsonloader(filepath)
            print(jsondata)
            for i in jsondata['users']:
                print(i)
                textBox.insert("1.0", i) #This now reads and displays the text
            messagebox = tk.messagebox.Message(title="File Read", message=jsondata)
            messagebox.show() #Displays message box with content from read file

            # with open(filepath, "r") as file:
            #     filecontents = file.read()
            #     textBox.insert("1.0", filecontents) #This now reads and displays the text
            #     messagebox = tk.messagebox.Message(title="File Read", message=filecontents)
            #     messagebox.show() #Displays message box with content from read file
            
        textBox = tk.Text(self, height=10, width=50)
        textBox.grid(row=4, column=0, padx=10, pady=10, columnspan=4)
        
        ##SCROLLBAR FOR TEXTBOX
        # vertScrollbar = tk.Scrollbar(textBox, orient="vertical", command=textBox.yview)
        # vertScrollbar.config(command=textBox.yview)
        # vertScrollbar.grid(row=4, column=4)
        # textBox.configure(yscrollcommand=vertScrollbar.set)
        # vertScrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        buttonCommit = tk.Button(self, height=1, width=10, text="Commit",
                                 command= read_file)
        # command=lambda: retrieve_input() >>> just means do this when i press the button
        buttonCommit.grid(row=3, column=3, padx=10, pady=10)

# Driver Code
app = tkinterApp()
app.mainloop()
